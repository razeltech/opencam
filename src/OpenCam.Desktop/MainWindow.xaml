<Window x:Class="OpenCam.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenCam"
        Height="560" Width="820"
        MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <!-- STATE 1: WAITING FOR PHONE (Iriun-inspired clean layout) -->
        <Grid x:Name="WaitingView" Margin="20" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Intro Card -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="18,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Logs" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnOpenLogs_Click" />
                        <Button Content="Settings" Style="{StaticResource SecondaryButton}" Click="BtnOpenSettings_Click" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="OpenCam turns your phone into a wireless Webcam." FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Use your mobile camera in OBS Studio, Zoom, Teams, Google Meet, or Discord."
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Center Pairing Card -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock x:Name="WaitingStatusTitle" Text="Waiting for phone connection..." FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Please make sure that:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="1. Phone and this PC are on the same Wi-Fi network" FontSize="13" Margin="0,2" />
                        <TextBlock Text="2. Scan the QR code or open the pairing URL in Chrome / Safari" FontSize="13" Margin="0,2" />
                        <TextBlock Text="3. Accept the local HTTPS certificate prompt if asked" FontSize="13" Margin="0,2,0,14" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    MaxWidth="320"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="PairingUrlText" Text="Starting server..." FontFamily="Consolas" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Content="Copy URL" Style="{StaticResource SecondaryButton}" Click="BtnCopyUrl_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnDriverAction" Content="Register Virtual Camera" Style="{StaticResource SecondaryButton}" Click="BtnDriverAction_Click" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#FFFFFF" Padding="10" CornerRadius="8" VerticalAlignment="Center">
                        <Image x:Name="QrCodeImage" Width="176" Height="176" />
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom Quick Toggles -->
            <DockPanel Grid.Row="2">
                <StackPanel DockPanel.Dock="Left">
                    <CheckBox x:Name="ChkBlankWhenDisconnected" Content="Blank video when no connection" Margin="0,0,0,6" Checked="ChkQuickOption_Changed" Unchecked="ChkQuickOption_Changed" />
                    <CheckBox x:Name="ChkStartWithWindows" Content="Start OpenCam when I start Windows" Checked="ChkQuickOption_Changed" Unchecked="ChkQuickOption_Changed" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DriverStatusBadge" Text="Virtual Cam: Checking..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="BtnToggleServer" Content="Stop Server" Style="{StaticResource SecondaryButton}" Click="BtnToggleServer_Click" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- STATE 2: STREAMING LIVE (Iriun-inspired clean full-frame preview) -->
        <Grid x:Name="StreamingView" Background="#000000" Visibility="Collapsed">
            <Image x:Name="PreviewImage" Stretch="Uniform" />

            <!-- Floating Translucent Top Bar -->
            <Border VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Background="#CC13161C"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="TelemetryPill" Text="--" FontFamily="Consolas" FontSize="12" Foreground="#D4D4D8" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="Copy URL" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnCopyUrl_Click" />
                        <Button Content="Logs" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnOpenLogs_Click" />
                        <Button Content="Settings" Style="{StaticResource SecondaryButton}" Click="BtnOpenSettings_Click" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="ComboActiveSource" Width="170" Margin="0,0,8,0" SelectionChanged="ComboActiveSource_SelectionChanged" />
                        <ComboBox x:Name="ComboQualityTop" Width="130" Margin="0,0,8,0" SelectionChanged="ComboQualityTop_SelectionChanged" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- MODAL OVERLAY: SETTINGS -->
        <Grid x:Name="SettingsOverlay" Background="#AA000000" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorder}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <Button Content="Close" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Click="BtnCloseOverlays_Click" />
                    </DockPanel>

                    <TextBlock Text="Network Adapter" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="ComboAdapters" Margin="0,0,0,12" />

                    <TextBlock Text="Server Port" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtPort" Margin="0,0,0,12" />

                    <TextBlock Text="Theme" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="ComboTheme" Margin="0,0,0,12">
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Light" />
                    </ComboBox>

                    <CheckBox x:Name="ChkRequirePin" Content="Require Pairing PIN" Margin="0,2,0,8" />
                    <TextBox x:Name="TxtPin" Margin="0,0,0,16" />

                    <DockPanel>
                        <Button Content="Unregister Driver" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left" Click="BtnUnregisterDriver_Click" />
                        <Button Content="Save &amp; Apply" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="BtnSaveSettings_Click" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL OVERLAY: LOGS -->
        <Grid x:Name="LogsOverlay" Background="#AA000000" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorder}" Margin="32" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Logs &amp; Audit Trail" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Copy" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnCopyLogs_Click" />
                            <Button Content="Open Folder" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnOpenLogFolder_Click" />
                            <Button Content="Clear" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnClearLogs_Click" />
                            <Button Content="Close" Style="{StaticResource PrimaryButton}" Click="BtnCloseOverlays_Click" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="LogsGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="95" />
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="65" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="95" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
